{
  "name": "wedding-host",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nuxt build",
    "predev": "docker compose up -d --wait db",
    "dev": "nuxt dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:create-admin": "node scripts/create-admin.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "eslint": "eslint . && node scripts/visual-hierarchy-check.mjs",
    "typelint": "nuxi typecheck",
    "customize": "node customize",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@neondatabase/serverless": "^1.1.0",
    "@nuxt/ui": "^4.6.0",
    "@pinia/nuxt": "^0.11.3",
    "@sentry/nuxt": "^10.63.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "nuxt": "^4.4.2",
    "pg": "^8.22.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.2.2",
    "vue": "^3.5.30",
    "vue-router": "^5.0.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/test-utils": "^4.0.0",
    "@playwright/test": "^1.58.2",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@vue/test-utils": "^2.4.6",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.8.7",
    "husky": "^9.1.7",
    "pixelmatch": "^7.1.0",
    "playwright-core": "^1.58.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "vitest": "^4.1.1",
    "vue-tsc": "^3.3.5"
  }
}
