#!/usr/bin/env sh
# Pre-push：只跑煙霧 spec（由下方 SMOKE_PATTERN 定義：00-auth 管理員註冊｜00-hydration 逐 route 整頁載入），本機 dev server。
#
# 分級（SSOT：.claude/skills/vibe-check/SKILL.md）：
#   本機 /vibe-check 預設定向（煙霧＋受影響 spec）、發 PR 前 /vibe-check --full 跑 dev 全量、
#   CI 的 e2e job（.github/workflows/pull_request.yml）跑 production build 全量——
#   「改 A 有沒有壞 B」的完整回歸在 CI，不在這裡。pre-push 防的是手滑：整頁載不出來、
#   註冊與 auth API 壞掉這種一推就炸的東西，一兩分鐘內給答案。
# scripts/docker-gate.sh（production 全量＋一次性 Postgres）改為本機選配，pre-push 不再呼叫它。
# 注意：煙霧 spec 的 beforeEach 會打 reset，本機 5433 的手動資料會被清空（issue #178 已接受此取捨）。
# specs/ 紅燈 = 破壞 Business Invariant（修 UI 不可改 spec）。
#
# 最佳化：若本次 push 的 commit「只動到非程式碼檔」（.env*／docs／docker 設定等），
# 這些變更不會影響被測程式邏輯，因此跳過測試，不必空等。
# 保守原則：只要有任何一個程式碼檔被改到，就照常跑煙霧。
# 注意：SKIP_PATTERN／SMOKE_PATTERN 這兩行被 /vibe-check 用 sed 抽走當同一份判準，格式（單引號、一行）不可變。

z40="0000000000000000000000000000000000000000"

# 非程式碼檔白名單（符合者視為不影響測試）：
#   .env*／*.md／docker 設定／*.txt 等純設定，以及 .husky/ 下的 git hook 本身
#   （E2E 守的是 UI 業務合約，git hook 邏輯不歸它守，故改 hook 不必跑 E2E）
#   docs/ 整個目錄為純文件（含 .json metadata sidecar 等），不影響被測程式
#   scripts/docker-gate.sh 是 gate 基礎設施本身，同 .husky/ 邏輯
SKIP_PATTERN='(^|/)\.env($|\.)|\.md$|^docker-compose\.ya?ml$|^Dockerfile$|^\.dockerignore$|^\.gitignore$|^LICENSE$|\.txt$|(^|/)\.husky/|(^|/)docs/|^scripts/docker-gate\.sh$'

# 煙霧集合（分級的最小集合）：regex，對 spec 檔路徑比對（Playwright 位置參數語意）。
# 本專案的煙霧是 00-auth、00-hydration 兩支（模板預設的 01-auth-guard／02-authz-scope 在本專案不存在）。
# /vibe-check 用 sed 抽這一行當同一份判準，格式（單引號、一行）不可變。
SMOKE_PATTERN='specs/(00-auth|00-hydration)'

# ── 設定自檢（一定放在下方「要不要跑」判定之前）──
# .husky/ 本身在 SKIP_PATTERN 內：只改這個檔的 push 會走「跳過測試」那條路。自檢若放在那之後，
# 把 pattern 改壞的那次 push 會直接推上去（CI 不跑 hook），之後每次 push 都靜默放行或跑錯集合。
# 判準是 grep 的 exit code 2（非法 ERE）；合法 pattern 對空輸入回 1 是正常的。
ere_ok() { rc=0; printf '' | grep -qE "$1" 2>/dev/null || rc=$?; [ "$rc" -le 1 ]; }
# 空字串會反轉語意：grep -vE '' 把所有檔濾掉（永遠跳過測試）、grep -E '' 命中所有 spec（煙霧變整份 gate），
# 而 /vibe-check 抽到空的 SMOKE_PATTERN 會改用預設值，兩邊判準就不一致——一律擋下。
for name in SKIP_PATTERN SMOKE_PATTERN; do
  eval "val=\$$name"
  if [ -z "$val" ]; then
    echo "❌ ${name} 是空的 → 拒絕 push。請在 .husky/pre-push 填回實際的 regex（SMOKE_PATTERN 本專案為 'specs/(00-auth|00-hydration)'）。"
    exit 1
  fi
  if ! ere_ok "$val"; then
    echo "❌ ${name} 不是合法的 ERE（${val}）→ 拒絕 push。"
    echo "   請修正 .husky/pre-push 的 ${name} 那一行（/vibe-check 用 sed 抽同一份判準）。"
    exit 1
  fi
done

need_test=0

# git 透過 stdin 傳入 <local_ref> <local_sha> <remote_ref> <remote_sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  # 刪除遠端分支（local_sha 全 0）：無內容可測，略過
  [ "$local_sha" = "$z40" ] && continue

  if [ "$remote_sha" = "$z40" ]; then
    # 新分支：無法可靠界定變更範圍，保守起見照跑煙霧
    need_test=1
    break
  fi

  files=$(git diff --name-only "$remote_sha" "$local_sha")
  # 濾掉白名單後若仍有剩 → 有程式碼變更，需要跑測試
  # 注意：husky 以 `sh -e` 執行本檔，grep 全濾掉時回傳 1 會觸發 errexit，故加 || true
  remaining=$(printf '%s\n' "$files" | grep -vE "$SKIP_PATTERN" || true)
  if [ -n "$remaining" ]; then
    need_test=1
    break
  fi
done

if [ "$need_test" -eq 0 ]; then
  echo "✅ 本次 push 只動到非程式碼檔（.env／docs／docker 等），不影響測試 → 跳過煙霧 spec。"
  exit 0
fi

# 沒有任何檔命中 SMOKE_PATTERN（檔名改了卻沒同步這一行）→ 印警告放行；production 全量仍由 CI 守。
# 比對對象要跟 Playwright 一樣：它把位置參數當 regex、對 spec 的「絕對路徑」比對、不分大小寫。
# 所以這裡 find 用絕對路徑、grep 加 -i，同一個 pattern 在兩邊命中的檔才一致；用 ^ 錨定 specs/ 的 pattern 兩邊都不會命中。
# 兩邊的 regex 方言不同（JS vs POSIX ERE），只用交集：分組、| 交替、字元集；\d、(?:…) 這類 JS 專屬寫法不要用。
# 注意：目錄不存在時 find 回非 0、grep 沒命中回 1，sh -e 會觸發 errexit，故加 || true
smoke_specs=$(find "$PWD/test/e2e/specs" -name '*.spec.ts' 2>/dev/null | grep -iE "$SMOKE_PATTERN" || true)
if [ -z "$smoke_specs" ]; then
  echo "⚠️  沒有 spec 檔命中 SMOKE_PATTERN（${SMOKE_PATTERN}）→ 跳過 pre-push 煙霧。"
  echo "   請把 SMOKE_PATTERN 改成實際的煙霧檔名。production 全量仍由 CI 的 e2e job 守。"
  exit 0
fi

# 位置參數是對檔案路徑做 regex 比對，SMOKE_PATTERN 一個 pattern 涵蓋所有煙霧檔。
# --reporter=line 只印失敗——AI 執行 git push 時回到對話的輸出只剩有用的部分（config 預設 list 每條測試印一行）。
# 刻意不用 --last-failed：它與檔名篩選是 AND、缺 .last-run.json 時靜默跑全量、零失敗時 exit 1。
# 注意：husky 以 sh -e 執行本檔，用 `|| gate_status=$?` 接住失敗才能印出下方分流指引
# dev server 的 predev 會 docker compose up db：次要 worktree 的預設 project 名不同，會撞 wedding-host-db 容器名。
# 未指定時一律共用主容器（見 CLAUDE.md「容器名固定」）
export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-wedding-host}"
echo "🔍 Running smoke spec（${SMOKE_PATTERN}，dev server）…"
gate_status=0
npx playwright test --config playwright.gate.config.ts --reporter=line "$SMOKE_PATTERN" || gate_status=$?

if [ "$gate_status" -ne 0 ]; then
  echo ""
  echo "❌ Smoke spec failed. 依失敗的 spec 分流："
  echo "   → 00-hydration 紅燈 = 某條 route 整頁載不出來或有 hydration 警告；先本機開該頁看 console。"
  echo "   → 00-auth 紅燈 = 管理員註冊流程（auth API／middleware）壞了；修 middleware／server，不可改 test/e2e/specs/（凍結）。"
  echo "   → 煙霧已全綠但 push 因 SSH timeout 中斷時，可 --no-verify 重推（驗證已完成非跳過）。"
  echo "   → 其他情況勿用 --no-verify（CLAUDE.md 政策禁止；那會讓 CI 成為唯一守門）。"
  exit 1
fi

echo "✅ Smoke spec passed. Push proceeding（production 全量由 CI 的 e2e job 跑）。"
