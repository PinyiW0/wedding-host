# === Docker 相關 ===
# 專案代號（compose 會自動補 -frontend 後綴，請勿自行加）
PROJECT_NAME=nuxt4-template
IMAGE_TAG=latest
HOST_PORT=3000

# === Nuxt Runtime Config ===
NUXT_APP_BASE_URL=/
# 統一 API domain（覆蓋 runtimeConfig.public.apiBase）
# mock 階段：前後端同源（mock API 由本 nuxt server 提供），留空走相對路徑即可
#（wrapper 路徑已內含 /api/v1 前綴，不可重複）。M0 接「外部」後端時才設為該 API host。
NUXT_PUBLIC_API_BASE=
NUXT_PRIVATE_GOOGLE_SHEET_KEY=

# === 認證（M0-a）===
# enforced 環境必須設定隨機長字串（解開註解填值；留空值會覆蓋掉開發預設導致啟動錯誤）
# NUXT_JWT_SECRET=
# NUXT_GUEST_LINK_SECRET=
# 認證模式：production build 預設 enforced、dev 預設 open；需要時可強制覆蓋
# NUXT_AUTH_MODE=enforced

# === LINE Messaging API（M4 基礎建設：申請 OA + channel 後填入即啟用真發送）===
NUXT_LINE_CHANNEL_ACCESS_TOKEN=

# === LINE Login OAuth（M4 賓客綁定：同 provider 建 LINE Login channel 後填入）===
# ID + secret 留空＝bind 頁維持 mock 綁定；填入後「綁定 LINE」走真 OAuth
NUXT_LINE_LOGIN_CHANNEL_ID=
NUXT_LINE_LOGIN_CHANNEL_SECRET=
# callback 網址（LINE console 需登錄一致）；留空時以請求 origin 推導，正式環境建議明確指定
# NUXT_LINE_LOGIN_REDIRECT_URI=https://<正式站>/api/line-login/callback

# === 資料庫（M0-b）===
# 本機預設走 docker-compose 的 Postgres（npm run dev 會自動拉起），不需設定
# 正式環境填 Neon pooled 連線字串（解開註解填值；留空值會覆蓋掉開發預設）
# NUXT_DATABASE_URL=
